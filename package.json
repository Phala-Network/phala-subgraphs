{
  "name": "phala-subgraphs",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "graph codegen ethereum.yaml && graph codegen base.yaml",
    "build": "graph build ethereum.yaml --output-dir build/ethereum && graph build base.yaml --output-dir build/base",
    "test": "graph test -v 0.6.0",
    "test:verify": "bun test scripts",
    "verify": "bun scripts/verify.ts",
    "check": "biome ci .",
    "typecheck": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.2",
    "matchstick-as": "0.6.0",
    "typescript": "7.0.2",
    "viem": "2.56.8"
  },
  "packageManager": "bun@1.4.2"
}
